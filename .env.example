# Copy to .env and fill in. Every value here is optional — with no keys at all
# the app still runs end to end, on the built-in deterministic parser (see
# samples/). Nothing here is required for the demo.

# ---- Shop identity (shows up on the dashboard and in reminders) ----
SHOP_NAME=Suresh Kirana
SHOP_LANG=mr

# ---- Lane 1: open-weight Gemma 4, free tier on Google AI Studio ----
# Key: https://aistudio.google.com/apikey  (no card required)
# Gemma 4 is served on the native generateContent route, not the OpenAI-
# compatible one, so this lane talks to that route directly. Gemma 3 was
# retired from the Gemini API in 2026 and will answer 404.
AI_STUDIO_API_KEY=
AI_STUDIO_MODEL=gemma-4-26b-a4b-it
AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Lane 2: failover, open-weight Qwen vision, free tier on Groq ----
# Key: https://console.groq.com/keys  (no card required)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Optional: fully local, GPU-free. One line, no code change. ----
# Install Ollama (https://ollama.com), then:  ollama pull gemma3:4b
# Uncomment both lines below to run the whole pipeline on-device.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gemma3:4b

# ---- Local OCR (the on-device layer) ----
# auto | rapidocr | paddleocr | tesseract | none
# "auto" probes for whatever is installed. Pin one and auto honours it.
OCR_BACKEND=auto

# ---- App ----
UDHAAR_DB=data/udhaar.db
